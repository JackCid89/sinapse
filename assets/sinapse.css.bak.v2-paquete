/* ──────────────────────────────────────────────────────────────────────
   Sinapse · stylesheet
   v1.0 · diseño editorial paper-warm para lectura larga
   ──────────────────────────────────────────────────────────────────────

   Carga los tipos desde Google Fonts en el <head>:

   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

   Identidad por defecto: paleta `aurora` + tema `paper`.
   El usuario final puede cambiar paleta/tema/tamaño/densidad — ver reader-preferences.js
   que aplica los atributos data-palette / data-theme / data-density y la variable
   --fs-body / --measure sobre <html>.
   ────────────────────────────────────────────────────────────────────── */

:root{
  /* ─── Paleta identidad (set por [data-palette]) ──────────────────────
     Aurora · azul ultramar sobre marfil frío. Identidad por defecto. */
  --hue: 255;
  --paper-c: 0.008;        /* chroma del fondo */
  --ink-c: 0.020;          /* chroma de la tinta */
  --accent: oklch(0.50 0.19 262);
  --accent-soft: oklch(0.93 0.05 262);
  --hl: oklch(0.95 0.04 255);

  /* ─── Tema (light/sepia/eink) ──────────────────────────────────────── */
  --paper: oklch(0.972 var(--paper-c) var(--hue));
  --paper-2: oklch(0.948 var(--paper-c) var(--hue));
  --ink: oklch(0.20 var(--ink-c) var(--hue));
  --ink-2: oklch(0.40 var(--ink-c) var(--hue));
  --ink-3: oklch(0.58 calc(var(--ink-c) * 0.7) var(--hue));
  --rule: oklch(0.84 calc(var(--ink-c) * 0.6) var(--hue));
  --rule-2: oklch(0.91 calc(var(--ink-c) * 0.5) var(--hue));

  /* ─── Tipografía ──────────────────────────────────────────────────── */
  --serif: "Source Serif 4", "Iowan Old Style", "Charter", Georgia, serif;
  --display: "Instrument Serif", "Source Serif 4", Georgia, serif;
  --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

  /* ─── Layout ──────────────────────────────────────────────────────── */
  --measure: 38rem;         /* ~608px @ 16px · ancho de columna principal */
  --measure-wide: 52rem;
  --fs-body: 18px;
  --leading: 1.65;

  --gap: 1.25rem;
  --gap-lg: 2.5rem;
  --gap-xl: 4rem;
}

/* ─── Paletas alternativas ────────────────────────────────────────────── */
[data-palette="aurora"]{
  --hue: 255; --paper-c: 0.008; --ink-c: 0.020;
  --accent: oklch(0.50 0.19 262);
  --accent-soft: oklch(0.93 0.05 262);
  --hl: oklch(0.95 0.04 255);
}
[data-palette="vermilion"]{
  --hue: 40; --paper-c: 0.010; --ink-c: 0.018;
  --accent: oklch(0.58 0.22 32);
  --accent-soft: oklch(0.93 0.07 35);
  --hl: oklch(0.95 0.06 75);
}
[data-palette="verde"]{
  --hue: 120; --paper-c: 0.010; --ink-c: 0.020;
  --accent: oklch(0.46 0.13 140);
  --accent-soft: oklch(0.92 0.06 140);
  --hl: oklch(0.94 0.05 120);
}
[data-palette="tinta"]{
  --hue: 90; --paper-c: 0.003; --ink-c: 0.005;
  --accent: oklch(0.78 0.20 118);
  --accent-soft: oklch(0.92 0.10 118);
  --hl: oklch(0.95 0.10 115);
}

/* ─── Modos sepia / e-ink (sobreescriben brillo, preservan acento de paleta) */
[data-theme="sepia"]{
  --paper: oklch(0.92 0.030 var(--hue));
  --paper-2: oklch(0.90 0.032 var(--hue));
  --ink: oklch(0.27 0.025 var(--hue));
  --ink-2: oklch(0.43 0.022 var(--hue));
  --ink-3: oklch(0.58 0.018 var(--hue));
  --rule: oklch(0.78 0.025 var(--hue));
  --rule-2: oklch(0.84 0.020 var(--hue));
}
[data-theme="eink"]{
  --paper: oklch(0.18 0.008 var(--hue));
  --paper-2: oklch(0.22 0.010 var(--hue));
  --ink: oklch(0.94 0.008 var(--hue));
  --ink-2: oklch(0.78 0.010 var(--hue));
  --ink-3: oklch(0.62 0.012 var(--hue));
  --rule: oklch(0.34 0.012 var(--hue));
  --rule-2: oklch(0.28 0.012 var(--hue));
  --accent-soft: oklch(0.30 0.08 var(--hue));
  --hl: oklch(0.28 0.05 var(--hue));
}

/* ─── Densidad ────────────────────────────────────────────────────────── */
[data-density="compact"]{--leading:1.55;--gap-xl:3rem;--gap-lg:2rem}
[data-density="spacious"]{--leading:1.78;--gap-xl:5.5rem;--gap-lg:3.5rem}

/* ─── Base ────────────────────────────────────────────────────────────── */
*{box-sizing:border-box}
html,body{margin:0;padding:0}
html{background:var(--paper)}
body{
  font-family:var(--serif);
  font-size:var(--fs-body);
  line-height:var(--leading);
  color:var(--ink);
  background:var(--paper);
  font-feature-settings:"kern","liga","onum","ss01";
  text-rendering:optimizeLegibility;
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease, color .3s ease;
}
::selection{background:var(--accent-soft);color:var(--ink)}
a{
  color:var(--ink);
  text-decoration:underline;
  text-decoration-color:var(--rule);
  text-underline-offset:.18em;
  text-decoration-thickness:.06em;
}
a:hover{text-decoration-color:var(--accent);color:var(--accent)}

/* ─── Page container ──────────────────────────────────────────────────── */
.page{max-width:var(--measure);margin:0 auto;padding:5rem 1.5rem 6rem}
.wide{max-width:var(--measure-wide);margin:0 auto}

/* ─── Masthead ────────────────────────────────────────────────────────── */
.masthead{
  border-top:2px solid var(--ink);
  border-bottom:1px solid var(--ink);
  padding:1rem 0 .8rem;
  margin-bottom:2.5rem;
  display:grid;
  grid-template-columns:1fr auto;
  gap:.5rem 1rem;
  align-items:end;
}
.wordmark{
  font-family:var(--display);
  font-style:italic;
  font-weight:400;
  font-size:clamp(3rem, 8vw, 4.8rem);
  line-height:.85;
  letter-spacing:-.005em;
  margin:0;
}
.wordmark a{text-decoration:none;color:var(--ink)}
.wordmark .dot{color:var(--accent);font-style:normal;margin-left:-.05em}

.masthead .meta{
  font-family:var(--mono);
  font-size:11px;
  line-height:1.5;
  text-transform:uppercase;
  letter-spacing:.06em;
  color:var(--ink-2);
  text-align:right;
}
.masthead .meta strong{color:var(--ink);font-weight:500}

.sub{
  font-family:var(--mono);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--ink-2);
  margin:0 0 1rem;
  display:flex;flex-wrap:wrap;gap:1rem 1.5rem;align-items:baseline;
}
.sub .lang a{color:var(--ink-2);text-decoration:none;border-bottom:1px solid var(--rule)}
.sub .lang a[aria-current]{color:var(--ink);border-color:var(--ink)}

/* ─── TOC ─────────────────────────────────────────────────────────────── */
.toc{margin:1.75rem 0 0;border-top:1px solid var(--rule);padding-top:1rem}
.toc ol{
  list-style:none;padding:0;margin:0;
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  column-gap:1.5rem;row-gap:.35rem;
  font-family:var(--mono);font-size:12px;
}
.toc a{
  display:flex;justify-content:space-between;gap:.75rem;
  padding:.25rem 0;text-decoration:none;color:var(--ink-2);
  border-bottom:1px dotted transparent;
}
.toc a:hover{color:var(--ink);border-bottom-color:var(--rule)}
.toc .num{color:var(--ink-3);font-variant-numeric:tabular-nums}
.toc .lead{flex:1;border-bottom:1px dotted var(--rule-2);margin:0 .5rem;align-self:end;height:1px;transform:translateY(-3px)}

/* ─── Lede / intro ────────────────────────────────────────────────────── */
.lede{
  margin:2rem 0 0;font-style:italic;color:var(--ink-2);
  font-size:1.05rem;line-height:1.55;
  border-left:2px solid var(--accent);padding:.1rem 0 .1rem 1rem;
}
.lede strong{font-style:normal;color:var(--ink)}

/* ─── Section ─────────────────────────────────────────────────────────── */
section.sec{
  margin-top:var(--gap-xl);padding-top:2rem;
  border-top:1px solid var(--ink);scroll-margin-top:1rem;
}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}
.sec-num{
  font-family:var(--mono);font-size:11px;letter-spacing:.1em;
  color:var(--ink-3);text-transform:uppercase;
}
.sec-title{
  font-family:var(--display);font-style:italic;font-weight:400;
  font-size:clamp(2.2rem,4.8vw,3rem);line-height:1;margin:0;letter-spacing:-.005em;
}
.sec-desc{
  font-family:var(--serif);font-style:italic;color:var(--ink-2);
  font-size:1rem;max-width:32rem;margin:-.5rem 0 2rem;
}

/* ─── Tags ────────────────────────────────────────────────────────────── */
.tags{
  display:flex;flex-wrap:wrap;gap:.4rem;
  font-family:var(--mono);font-size:10px;
  text-transform:uppercase;letter-spacing:.08em;
  color:var(--ink-2);margin:0 0 .6rem;
}
.tag{
  display:inline-block;padding:2px 7px 1px;
  border:1px solid var(--rule);border-radius:2px;
  color:var(--ink-2);background:transparent;line-height:1.4;
}
.tag.accent{color:var(--accent);border-color:var(--accent)}

/* ─── Pulso ───────────────────────────────────────────────────────────── */
.pulso{display:flex;flex-direction:column;gap:2rem}
.pulso-item{
  display:grid;grid-template-columns:3.5rem 1fr;gap:1.25rem;
  padding-bottom:1.75rem;border-bottom:1px solid var(--rule-2);
}
.pulso-item:last-child{border-bottom:0;padding-bottom:0}
.pulso-num{font-family:var(--mono);font-size:10px;color:var(--ink-3);letter-spacing:.1em;padding-top:.25rem}
.pulso-num .ord{
  display:block;font-family:var(--display);font-style:italic;
  font-size:2.4rem;color:var(--ink);line-height:1;margin-bottom:.25rem;
}
.pulso-body h3{
  font-family:var(--serif);font-weight:600;font-size:1.25rem;line-height:1.25;
  margin:0 0 .5rem;font-variation-settings:"opsz" 24;text-wrap:pretty;
}
.pulso-body p{margin:.5rem 0 0}

.enclaro{
  margin-top:.85rem;padding:.7rem .9rem;
  background:var(--hl);border-left:2px solid var(--accent);
  font-size:.95rem;line-height:1.55;color:var(--ink);
}
.enclaro::before{
  content:"En claro";display:block;
  font-family:var(--mono);font-size:9px;
  text-transform:uppercase;letter-spacing:.12em;
  color:var(--accent);margin-bottom:.25rem;
}

/* ─── Article (Portada / Columna / Contraste) ─────────────────────────── */
.portada-meta{
  font-family:var(--mono);font-size:11px;
  text-transform:uppercase;letter-spacing:.1em;
  color:var(--ink-2);margin:0 0 .75rem;
}
.article-title{
  font-family:var(--display);font-weight:400;
  font-size:clamp(2.4rem,5.5vw,3.6rem);line-height:1.02;
  letter-spacing:-.01em;margin:0 0 1rem;text-wrap:balance;
}
.article-title em{font-style:italic;color:var(--accent)}
.article-deck{
  font-family:var(--serif);font-style:italic;font-weight:400;
  font-size:1.2rem;line-height:1.5;color:var(--ink-2);
  margin:0 0 1.5rem;text-wrap:pretty;
}
.byline{
  font-family:var(--mono);font-size:11px;
  text-transform:uppercase;letter-spacing:.08em;color:var(--ink-3);
  border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);
  padding:.6rem 0;margin:0 0 2rem;
  display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;
}

.prose p{margin:0 0 1rem;text-wrap:pretty;hyphens:auto;-webkit-hyphens:auto}
.prose h3{
  font-family:var(--serif);font-weight:600;font-size:1.3rem;line-height:1.25;
  margin:2.5rem 0 .75rem;font-variation-settings:"opsz" 24;
}
.prose h3::before{
  content:"";display:block;width:2.5rem;height:2px;
  background:var(--accent);margin-bottom:.7rem;
}

.dropcap::first-letter{
  font-family:var(--display);font-style:italic;font-weight:400;
  float:left;font-size:5.5rem;line-height:.8;
  padding:.35rem .5rem 0 0;color:var(--accent);
}
.columna .article-title{font-style:italic}
.columna .prose p:first-of-type::first-letter{
  font-family:var(--display);font-style:italic;font-weight:400;
  float:left;font-size:4.5rem;line-height:.85;
  padding:.2rem .4rem 0 0;color:var(--ink);
}
.columna .prose p{font-size:1.02rem}

/* ─── Papers ──────────────────────────────────────────────────────────── */
.papers{display:grid;gap:2.5rem}
.paper{padding:1.5rem 0;border-top:1px solid var(--rule)}
.paper h3{
  font-family:var(--serif);font-weight:600;font-size:1.3rem;line-height:1.25;
  margin:.3rem 0 .5rem;text-wrap:pretty;
}
.paper .cite{font-family:var(--mono);font-size:11px;color:var(--ink-3);letter-spacing:.04em;margin:0 0 1rem}
.paper .why{
  margin-top:.85rem;padding-left:1rem;border-left:2px solid var(--accent-soft);
  color:var(--ink-2);font-style:italic;
}
.paper .why::before{
  content:"Por qué importa · ";
  font-family:var(--mono);font-style:normal;font-size:10px;
  text-transform:uppercase;letter-spacing:.1em;color:var(--accent);margin-right:.15rem;
}

/* ─── Tech / Industria ────────────────────────────────────────────────── */
.ti-grid{display:grid;gap:1.75rem}
.ti-item{
  display:grid;grid-template-columns:6.5rem 1fr;gap:1.25rem;align-items:baseline;
  padding-bottom:1.5rem;border-bottom:1px solid var(--rule-2);
}
.ti-item:last-child{border-bottom:0}
.ti-cat{
  font-family:var(--mono);font-size:10px;text-transform:uppercase;
  letter-spacing:.1em;color:var(--ink-3);line-height:1.4;
}
.ti-body h3{
  font-family:var(--serif);font-weight:600;font-size:1.15rem;line-height:1.3;
  margin:0 0 .5rem;text-wrap:pretty;
}
.ti-body p{margin:0;color:var(--ink-2)}

/* ─── Contraste · atlas + chart + sources ─────────────────────────────── */
.contraste .lede{font-size:1.1rem}
.contraste .quote{
  font-family:var(--serif);font-style:italic;
  font-size:1.15rem;line-height:1.5;color:var(--ink);
  padding:1rem 0 1rem 1.25rem;margin:1.5rem 0;
  border-left:3px solid var(--accent);
}
.quote-attr{
  display:block;font-family:var(--mono);font-style:normal;font-size:10px;
  text-transform:uppercase;letter-spacing:.1em;color:var(--ink-3);margin-top:.5rem;
}

.atlas{
  margin:2rem 0;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);
  padding:.5rem 0;
}
.atlas-head{
  font-family:var(--mono);font-size:10px;text-transform:uppercase;
  letter-spacing:.12em;color:var(--ink-3);padding:.5rem 0;
  border-bottom:1px solid var(--rule-2);
}
.atlas dl{
  display:grid;grid-template-columns:9rem 1fr;gap:.5rem 1.5rem;
  margin:0;padding:1rem 0;
}
.atlas dt{
  font-family:var(--mono);font-size:10px;text-transform:uppercase;
  letter-spacing:.1em;color:var(--accent);padding-top:.35rem;line-height:1.4;
}
.atlas dd{margin:0 0 1.25rem;font-size:.98rem;line-height:1.55;color:var(--ink)}
.atlas dd strong{font-weight:600}
.atlas dd em{font-style:italic;color:var(--ink-2)}

.chart{
  margin:2.5rem 0;padding:1.5rem 0;
  border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);
}
.chart-head{
  font-family:var(--mono);font-size:10px;text-transform:uppercase;
  letter-spacing:.12em;color:var(--ink-3);margin-bottom:1rem;
  display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;
}
.chart-head strong{color:var(--ink);font-weight:500}
.bars{display:flex;flex-direction:column;gap:.7rem}
.bar-row{
  display:grid;grid-template-columns:5.5rem 1fr 3.5rem;gap:.85rem;align-items:center;
  font-family:var(--mono);font-size:11px;color:var(--ink);
}
.bar-lbl{letter-spacing:.04em}
.bar-track{position:relative;height:18px;background:transparent;border-bottom:1px solid var(--rule-2)}
.bar-fill{position:absolute;left:0;top:2px;bottom:2px;background:var(--ink)}
.bar-fill .qual{position:absolute;left:0;top:0;bottom:0;background:var(--accent)}
.bar-val{font-variant-numeric:tabular-nums;color:var(--ink-2);text-align:right}
.chart-legend{
  margin-top:1rem;font-family:var(--mono);font-size:10px;
  color:var(--ink-3);text-transform:uppercase;letter-spacing:.08em;
  display:flex;gap:1.25rem;flex-wrap:wrap;
}
.swatch{display:inline-block;width:10px;height:10px;vertical-align:-1px;margin-right:.4rem}
.chart-foot{margin-top:.85rem;font-size:.85rem;font-style:italic;color:var(--ink-3)}

.sources{
  margin-top:2.5rem;padding:1.25rem 0;border-top:1px solid var(--rule);
  font-size:.9rem;color:var(--ink-2);
}
.sources h4{
  font-family:var(--mono);font-size:11px;text-transform:uppercase;
  letter-spacing:.1em;color:var(--ink-3);margin:0 0 .75rem;font-weight:500;
}
.sources ol{padding-left:1.5rem;margin:0;line-height:1.5}
.sources li{margin-bottom:.4rem}

/* ─── Dato de la semana ───────────────────────────────────────────────── */
.dato{
  text-align:center;padding:3rem 0 2.5rem;
  border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);
}
.dato-num{
  font-family:var(--display);font-style:italic;font-weight:400;
  font-size:clamp(9rem,24vw,18rem);line-height:.85;letter-spacing:-.03em;
  color:var(--accent);margin:0;
}
.dato-lbl{
  font-family:var(--mono);font-size:11px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--ink-2);margin:1rem 0 0;
}
.dato-body{
  max-width:32rem;margin:1.5rem auto 0;
  font-size:.98rem;color:var(--ink-2);line-height:1.6;
}

/* ─── Apéndice ────────────────────────────────────────────────────────── */
.appendix-paper{margin-bottom:2.5rem;padding:1.5rem 0;border-top:1px solid var(--rule)}
.appendix-paper h3{
  font-family:var(--serif);font-weight:600;font-size:1.15rem;line-height:1.3;
  margin:0 0 .5rem;display:flex;align-items:baseline;gap:.6rem;text-wrap:pretty;
}
.appendix-paper h3 .pnum{
  font-family:var(--mono);font-size:10px;font-weight:500;
  letter-spacing:.12em;color:var(--accent);text-transform:uppercase;
  flex-shrink:0;line-height:1.4;padding-top:.2rem;
}
.appendix-meta{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:.5rem 1rem;font-family:var(--mono);font-size:10px;
  text-transform:uppercase;letter-spacing:.08em;color:var(--ink-3);
  border-top:1px solid var(--rule-2);border-bottom:1px solid var(--rule-2);
  padding:.75rem 0;margin:1rem 0;
}
.appendix-meta strong{
  display:block;color:var(--ink);font-weight:500;
  font-family:var(--serif);font-size:.92rem;
  text-transform:none;letter-spacing:0;margin-top:.15rem;font-style:italic;
}
.appendix-paper dl{
  display:grid;grid-template-columns:7rem 1fr;gap:.4rem 1.25rem;
  margin:.75rem 0 0;font-size:.95rem;
}
.appendix-paper dt{
  font-family:var(--mono);font-size:10px;text-transform:uppercase;
  letter-spacing:.1em;color:var(--ink-3);padding-top:.3rem;
}
.appendix-paper dd{margin:0 0 .8rem;color:var(--ink-2);line-height:1.55}

/* ─── Colofón ─────────────────────────────────────────────────────────── */
.colofon{
  margin-top:5rem;padding-top:2rem;border-top:2px solid var(--ink);
  font-family:var(--mono);font-size:11px;line-height:1.7;color:var(--ink-2);
  text-transform:uppercase;letter-spacing:.06em;
}
.colofon strong{font-family:var(--serif);font-style:italic;text-transform:none;letter-spacing:0;color:var(--ink);font-size:.95rem}
.colofon a{color:var(--ink-2)}

/* ─── Reading progress bar ────────────────────────────────────────────── */
.progress{position:fixed;top:0;left:0;right:0;height:2px;z-index:50;pointer-events:none}
.progress .bar{height:100%;width:0;background:var(--accent);transition:width .1s linear}

/* ─── Mobile ──────────────────────────────────────────────────────────── */
@media (max-width:640px){
  .page{padding:2.5rem 1.25rem 4rem}
  .toc ol{grid-template-columns:1fr}
  .pulso-item{grid-template-columns:1fr;gap:.5rem}
  .pulso-num{display:flex;align-items:baseline;gap:.75rem;padding-top:0}
  .pulso-num .ord{font-size:1.4rem;margin:0}
  .ti-item{grid-template-columns:1fr;gap:.4rem}
  .atlas dl{grid-template-columns:1fr;gap:.25rem}
  .atlas dt{padding-top:.4rem}
  .atlas dd{margin-bottom:1rem}
  .appendix-meta{grid-template-columns:1fr}
  .appendix-paper dl{grid-template-columns:1fr;gap:.2rem}
  .bar-row{grid-template-columns:4.5rem 1fr 2.8rem;font-size:10px}
}

/* ─── Print ───────────────────────────────────────────────────────────── */
@media print{
  :root{--paper:#fff;--ink:#111}
  body{font-size:11pt}
  .page{max-width:none;padding:0 0 1cm}
  .progress, .reader-prefs, .reader-prefs-toggle{display:none !important}
  section.sec{break-inside:avoid-page;break-before:auto}
  .pulso-item,.paper,.ti-item,.appendix-paper{break-inside:avoid}
  a{color:#111}
}
